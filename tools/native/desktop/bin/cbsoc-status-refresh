#!/usr/bin/env bash
#
# cbsoc-status-refresh — regenerate /usr/local/share/cyberbluesoc/welcome/status.js
#
# Called every 30 seconds by cbsoc-status.timer. Walks `docker ps` and writes
# a tiny JS file that sets window.STATUS for the welcome dashboard. We use a
# JS file (not JSON) so the dashboard can load it with <script src="status.js">
# and avoid CORS issues when served from a file:// URL.

set -u

OUT="/usr/local/share/cyberbluesoc/welcome/status.js"
TMP="$(mktemp)"

# Primary IP — prefer the external ip that callers reach us on.
HOST="$(hostname -I 2>/dev/null | awk '{print $1}')"
[[ -z "$HOST" ]] && HOST="localhost"

TS="$(date +%s)"

# tiny JSON escaper — we only need quotes and backslashes since container
# names / docker states are plain ASCII.
jsq() { printf '"%s"' "${1//\"/\\\"}"; }

{
  echo "/* auto-generated by cbsoc-status-refresh — do not edit */"
  echo "window.STATUS = {"
  printf '  host: %s,\n'    "$(jsq "$HOST")"
  printf '  ts: %s,\n'      "$TS"
  echo  "  containers: {"

  if command -v docker >/dev/null 2>&1; then
    docker ps -a --format '{{.Names}}|{{.State}}|{{.Status}}' 2>/dev/null | \
    while IFS='|' read -r name state status; do
      [[ -z "$name" ]] && continue
      health="none"
      case "$status" in
        *"(healthy)"*)                     health="healthy"   ;;
        *"(unhealthy)"*)                   health="unhealthy" ;;
        *"(health: starting)"*|*"starting)"*) health="starting" ;;
      esac
      printf '    %s: { state: %s, health: %s },\n' \
        "$(jsq "$name")" "$(jsq "$state")" "$(jsq "$health")"
    done
  fi

  echo "  }"
  echo "};"
} > "$TMP"

install -m 0644 "$TMP" "$OUT"
rm -f "$TMP"
